{
  "name": "materials-mcp-schema-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare deployment boundary for immutable Materials MCP Profile schemas.",
  "author": "Hesham Salama",
  "license": "Apache-2.0",
  "scripts": {
    "prepare-assets": "node prepare-assets.mjs",
    "test": "node --test test/*.test.mjs",
    "precheck": "npm run test",
    "check": "npm run prepare-assets",
    "postcheck": "wrangler deploy --dry-run --outdir ../../.worker-dist",
    "predeploy": "npm run check",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260910.1",
    "typescript": "7.0.2",
    "wrangler": "4.131.0"
  }
}
