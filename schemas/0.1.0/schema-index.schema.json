{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autonomouslab.io/materials-mcp/0.1.0/schema-index.schema.json",
  "title": "Schema resource index",
  "description": "A checksum-pinned inventory of every normative schema resource in one exact profile version.",
  "type": "object",
  "required": ["contract", "profile_version", "canonical_base", "generated_at", "resources"],
  "properties": {
    "contract": {
      "const": "https://schemas.autonomouslab.io/materials-mcp/0.1.0/schema-index.schema.json"
    },
    "profile_version": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.1.0/common.schema.json#profileVersion"
    },
    "canonical_base": {
      "const": "https://schemas.autonomouslab.io/materials-mcp/0.1.0/"
    },
    "generated_at": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.1.0/common.schema.json#dateTime"
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["schema_id", "path", "sha256", "media_type"],
        "properties": {
          "schema_id": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.1.0/common.schema.json#httpsResourceId"
          },
          "path": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*\\.schema\\.json$",
            "maxLength": 128
          },
          "sha256": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.1.0/common.schema.json#sha256"
          },
          "media_type": {"const": "application/schema+json"}
        },
        "additionalProperties": false
      }
    }
  },
  "unevaluatedProperties": false
}
