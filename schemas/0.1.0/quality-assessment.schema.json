{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autonomouslab.io/materials-mcp/0.1.0/quality-assessment.schema.json",
  "title": "Quality assessment",
  "description": "An explicit assessment state, criteria, and applicability limitations without an implicit trust claim.",
  "type": "object",
  "required": ["status", "criteria", "limitations"],
  "properties": {
    "status": {
      "enum": ["not-assessed", "source-reported", "assessed"]
    },
    "reason": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.1.0/common.schema.json#nonEmptyString"
    },
    "criteria": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["criterion_id", "description", "status", "evidence_refs"],
        "properties": {
          "criterion_id": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.1.0/common.schema.json#absoluteReference"
          },
          "description": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.1.0/common.schema.json#nonEmptyString"
          },
          "status": {
            "enum": ["pass", "fail", "not-assessed"]
          },
          "evidence_refs": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.1.0/common.schema.json#absoluteReference"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.1.0/common.schema.json#nonEmptyString"
      }
    },
    "extensions": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.1.0/extension.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "not-assessed"}},
        "required": ["status"]
      },
      "then": {
        "required": ["reason"]
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "assessed"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "criteria": {"minItems": 1}
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
