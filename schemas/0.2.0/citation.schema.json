{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/citation.schema.json",
  "title": "Scientific citation",
  "description": "A bounded bibliographic reference supporting a scientific record or method.",
  "type": "object",
  "required": ["citation_ref", "title", "authors", "year", "identifier", "uri"],
  "properties": {
    "citation_ref": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
    },
    "title": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
      }
    },
    "year": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 9999
    },
    "identifier": {
      "type": "object",
      "required": ["scheme", "value"],
      "properties": {
        "scheme": {"enum": ["doi", "url", "other"]},
        "value": {
          "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "uri": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
    },
    "container_title": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
    },
    "extensions": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/extension.schema.json"
    }
  },
  "unevaluatedProperties": false
}
