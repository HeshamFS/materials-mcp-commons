{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/plugin-manifest.schema.json",
  "title": "Generic plugin manifest",
  "description": "A declarative, provider-neutral description of plugin identity, capabilities, contracts, effects, and packaged extension schemas.",
  "type": "object",
  "required": ["contract", "profile_version", "plugin_id", "plugin_version", "name", "description", "publisher", "license", "capabilities", "schema_resources", "extension_declarations"],
  "properties": {
    "contract": {
      "const": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/plugin-manifest.schema.json"
    },
    "profile_version": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#profileVersion"
    },
    "plugin_id": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#httpsResourceId"
    },
    "plugin_version": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#semanticVersion"
    },
    "name": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
    },
    "description": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#shortText"
    },
    "publisher": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
        },
        "uri": {
          "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
        }
      },
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "required": ["expression", "rights_uri"],
      "properties": {
        "expression": {
          "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#spdxExpression"
        },
        "rights_uri": {
          "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["capability_id", "title", "description", "effect", "input_schema", "result_schema", "error_schema", "supports_async"],
        "properties": {
          "capability_id": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#httpsResourceId"
          },
          "title": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
          },
          "description": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#shortText"
          },
          "effect": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/effect.schema.json"
          },
          "input_schema": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#httpsResourceId"
          },
          "result_schema": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#httpsResourceId"
          },
          "error_schema": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#httpsResourceId"
          },
          "supports_async": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "schema_resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "required": ["schema_id", "path", "sha256", "media_type", "role"],
        "properties": {
          "schema_id": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#httpsResourceId"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
            "maxLength": 512
          },
          "sha256": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#sha256"
          },
          "media_type": {"const": "application/schema+json"},
          "role": {"enum": ["input", "result", "error", "extension"]}
        },
        "additionalProperties": false
      }
    },
    "extension_declarations": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["schema_id", "applies_to"],
        "properties": {
          "schema_id": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#httpsResourceId"
          },
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#httpsResourceId"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/extension.schema.json"
    }
  },
  "unevaluatedProperties": false
}
