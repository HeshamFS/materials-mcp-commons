{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/structured-error.schema.json",
  "title": "Structured scientific error",
  "description": "A bounded failure record with cause, stage, evidence, retryability, and a corrective next action.",
  "type": "object",
  "required": ["contract", "profile_version", "error_ref", "code", "stage", "cause", "message", "evidence", "retryable", "next_action", "occurred_at"],
  "properties": {
    "contract": {
      "const": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/structured-error.schema.json"
    },
    "profile_version": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#profileVersion"
    },
    "error_ref": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
    },
    "run_ref": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
    },
    "stage": {
      "enum": ["discovery", "inspection", "validation", "planning", "authorization", "execution", "observation", "retrieval", "projection", "internal"]
    },
    "cause": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#shortText"
    },
    "message": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#shortText"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["kind", "summary"],
        "properties": {
          "kind": {"enum": ["input", "schema", "run", "artifact", "log", "policy", "other"]},
          "ref": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
          },
          "summary": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
          }
        },
        "additionalProperties": false
      }
    },
    "retryable": {"type": "boolean"},
    "next_action": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#shortText"
    },
    "occurred_at": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#dateTime"
    },
    "extensions": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/extension.schema.json"
    }
  },
  "unevaluatedProperties": false
}
