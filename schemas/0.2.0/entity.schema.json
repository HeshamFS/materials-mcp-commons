{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/entity.schema.json",
  "title": "Scientific entity",
  "description": "A stable, typed reference to a scientific subject or record.",
  "type": "object",
  "required": ["entity_ref", "entity_type", "label", "identifiers"],
  "properties": {
    "entity_ref": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
    },
    "entity_type": {
      "enum": ["material", "sample", "structure", "dataset", "publication", "software", "execution", "other"]
    },
    "label": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
    },
    "identifiers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["scheme", "value"],
        "properties": {
          "scheme": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#token"
          },
          "value": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
          },
          "uri": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/extension.schema.json"
    }
  },
  "unevaluatedProperties": false
}
