{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/provenance.schema.json",
  "title": "Scientific provenance",
  "description": "Traceable sources, transformations, producer, parameters, and execution context for a result.",
  "type": "object",
  "required": ["provenance_ref", "activity_ref", "activity_type", "started_at", "ended_at", "producer", "inputs", "parameters", "environment", "sources"],
  "properties": {
    "provenance_ref": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
    },
    "activity_ref": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
    },
    "activity_type": {
      "enum": ["source-projection", "query", "calculation", "measurement", "conversion", "analysis", "other"]
    },
    "started_at": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#dateTime"
    },
    "ended_at": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#dateTime"
    },
    "producer": {
      "type": "object",
      "required": ["producer_ref", "name", "version"],
      "properties": {
        "producer_ref": {
          "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
        },
        "name": {
          "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
        },
        "version": {
          "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
        },
        "uri": {
          "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
      }
    },
    "parameters": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "properties": {
          "name": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#token"
          },
          "value": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#shortText"
          }
        },
        "additionalProperties": false
      }
    },
    "environment": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "reason"],
          "properties": {
            "status": {"const": "not-applicable"},
            "reason": {
              "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status", "software", "platform"],
          "properties": {
            "status": {"const": "reported"},
            "software": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "type": "object",
                "required": ["name", "version"],
                "properties": {
                  "name": {
                    "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
                  },
                  "version": {
                    "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
                  }
                },
                "additionalProperties": false
              }
            },
            "platform": {
              "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["source_ref", "source_type", "title", "uri", "version", "retrieved_at", "rights", "size_bytes", "sha256", "transformations", "citation_refs"],
        "properties": {
          "source_ref": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
          },
          "source_type": {
            "enum": ["database-record", "dataset", "publication", "standard", "software", "execution", "user-input", "other"]
          },
          "title": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
          },
          "uri": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
          },
          "version": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
          },
          "retrieved_at": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#dateTime"
          },
          "rights": {
            "type": "object",
            "required": ["basis", "identifier", "uri", "redistribution", "attribution"],
            "properties": {
              "basis": {"enum": ["license", "public-domain", "access-only"]},
              "identifier": {
                "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#spdxExpression"
              },
              "uri": {
                "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
              },
              "redistribution": {"enum": ["permitted", "not-permitted", "unknown"]},
              "attribution": {
                "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
              }
            },
            "additionalProperties": false
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#sha256"
          },
          "transformations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 512,
            "items": {
              "type": "object",
              "required": ["operation", "source_locator", "target_pointer"],
              "properties": {
                "operation": {"enum": ["copy", "unit-annotation", "identifier-mapping", "other"]},
                "source_locator": {
                  "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
                },
                "target_pointer": {
                  "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#jsonPointer"
                },
                "note": {
                  "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
                }
              },
              "additionalProperties": false
            }
          },
          "citation_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/extension.schema.json"
    }
  },
  "unevaluatedProperties": false
}
