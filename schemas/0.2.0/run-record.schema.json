{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/run-record.schema.json",
  "title": "Durable run record",
  "description": "The durable identity and reconnectable state of long-running scientific work.",
  "type": "object",
  "required": ["contract", "profile_version", "run_ref", "capability_id", "effect", "state", "sequence", "owner", "created_at", "updated_at", "links", "artifact_refs"],
  "properties": {
    "contract": {
      "const": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/run-record.schema.json"
    },
    "profile_version": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#profileVersion"
    },
    "run_ref": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
    },
    "capability_id": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#httpsResourceId"
    },
    "effect": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/effect.schema.json"
    },
    "state": {"enum": ["queued", "running", "succeeded", "failed", "cancelled"]},
    "sequence": {"type": "integer", "minimum": 0},
    "owner": {
      "type": "object",
      "required": ["owner_ref", "scope"],
      "properties": {
        "owner_ref": {
          "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
        },
        "scope": {"enum": ["user", "project", "workspace", "service"]}
      },
      "additionalProperties": false
    },
    "created_at": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#dateTime"
    },
    "updated_at": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#dateTime"
    },
    "plan_ref": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
    },
    "result_ref": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
    },
    "error_ref": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
    },
    "links": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
        },
        "result": {
          "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
        },
        "cancel": {
          "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
        }
      },
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "required": ["fraction", "message"],
      "properties": {
        "fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "message": {
          "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "artifact_refs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
      }
    },
    "extensions": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/extension.schema.json"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "succeeded"}}, "required": ["state"]},
      "then": {"required": ["result_ref"]}
    },
    {
      "if": {"properties": {"state": {"const": "failed"}}, "required": ["state"]},
      "then": {"required": ["error_ref"]}
    },
    {
      "if": {
        "properties": {
          "effect": {
            "properties": {"tier": {"enum": ["R2", "R3", "R4"]}},
            "required": ["tier"]
          }
        },
        "required": ["effect"]
      },
      "then": {"required": ["plan_ref"]}
    }
  ],
  "unevaluatedProperties": false
}
