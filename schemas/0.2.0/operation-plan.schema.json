{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/operation-plan.schema.json",
  "title": "Deterministic operation plan",
  "description": "An inspectable plan describing exact steps, targets, permissions, approvals, outputs, estimates, and risks.",
  "type": "object",
  "required": ["contract", "profile_version", "plan_ref", "capability_id", "effect", "created_at", "input_sha256", "steps", "permissions", "approval", "expected_outputs", "estimates", "risks"],
  "properties": {
    "contract": {
      "const": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/operation-plan.schema.json"
    },
    "profile_version": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#profileVersion"
    },
    "plan_ref": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
    },
    "capability_id": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#httpsResourceId"
    },
    "effect": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/effect.schema.json"
    },
    "created_at": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#dateTime"
    },
    "input_sha256": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#sha256"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["step_id", "action", "description", "targets"],
        "properties": {
          "step_id": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#token"
          },
          "action": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#token"
          },
          "description": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["permission", "scope"],
        "properties": {
          "permission": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#token"
          },
          "scope": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
          }
        },
        "additionalProperties": false
      }
    },
    "approval": {
      "type": "object",
      "required": ["status", "confirmation_kind", "prompt"],
      "properties": {
        "status": {"enum": ["not-required", "required", "approved", "denied"]},
        "confirmation_kind": {"enum": ["none", "standard", "strong"]},
        "prompt": {
          "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
        },
        "expires_at": {
          "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#dateTime"
        }
      },
      "additionalProperties": false
    },
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["role", "media_type"],
        "properties": {
          "role": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#token"
          },
          "media_type": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#mediaType"
          }
        },
        "additionalProperties": false
      }
    },
    "estimates": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["kind", "value"],
        "properties": {
          "kind": {"enum": ["duration", "cost", "compute", "storage", "other"]},
          "value": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/scientific-value.schema.json"
          }
        },
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
      }
    },
    "recovery": {
      "type": "object",
      "required": ["available", "procedure"],
      "properties": {
        "available": {"type": "boolean"},
        "procedure": {
          "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/extension.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "effect": {
            "properties": {"tier": {"enum": ["R0", "R1"]}},
            "required": ["tier"]
          }
        },
        "required": ["effect"]
      },
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "status": {"const": "not-required"},
              "confirmation_kind": {"const": "none"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "effect": {
            "properties": {"tier": {"enum": ["R2", "R3"]}},
            "required": ["tier"]
          }
        },
        "required": ["effect"]
      },
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "status": {"enum": ["required", "approved", "denied"]},
              "confirmation_kind": {"enum": ["standard", "strong"]}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "effect": {
            "properties": {"tier": {"const": "R4"}},
            "required": ["tier"]
          }
        },
        "required": ["effect"]
      },
      "then": {
        "required": ["recovery"],
        "properties": {
          "approval": {
            "properties": {
              "status": {"enum": ["required", "approved", "denied"]},
              "confirmation_kind": {"const": "strong"}
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
