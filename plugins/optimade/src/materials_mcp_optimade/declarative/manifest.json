      "effect": {
        "approval_required": false,
        "category": "read-only",
        "description": "Performs bounded concurrent HTTPS reads from explicitly selected supported providers without persistence.",
        "plan_required": false,
        "strong_confirmation_required": false,
        "tier": "R0"
      },
      "error_schema": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/structured-error.schema.json",
