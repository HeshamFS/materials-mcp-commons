{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autonomouslab.io/materials-mcp/plugins/optimade/0.1.0/provider-inspect-input.schema.json",
  "title": "Inspect OPTIMADE provider input",
  "description": "Bounded metadata request for one configured and reviewed provider.",
  "type": "object",
  "required": [
    "provider_id",
    "entry_types",
    "include_property_definitions",
    "property_limit"
  ],
  "properties": {
    "provider_id": {
      "enum": ["mp", "nmd"]
    },
    "entry_types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": ["structures", "references"]
      }
    },
    "include_property_definitions": {
      "type": "boolean"
    },
    "property_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    }
  },
  "additionalProperties": false
}
