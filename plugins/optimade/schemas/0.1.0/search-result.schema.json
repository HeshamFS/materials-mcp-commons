{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autonomouslab.io/materials-mcp/plugins/optimade/0.1.0/search-result.schema.json",
  "title": "Bounded federated OPTIMADE search result",
  "description": "A zero-capable, provider-grouped, context-measured result with explicit partial failure, selected-field and whole-hit omissions, continuation-safe pagination, namespaced properties, rights, citation references, and response hashes.",
  "type": "object",
  "$defs": {
    "boundedValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number"},
        {"type": "string", "maxLength": 4096},
        {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/boundedValue"}
        },
        {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {"type": "string", "maxLength": 128},
          "additionalProperties": {"$ref": "#/$defs/boundedValue"}
        }
      ]
    },
    "providerMessage": {
      "type": "object",
      "required": ["title", "detail"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 128},
        "http_status": {"type": "integer", "minimum": 0, "maximum": 599},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "detail": {"type": "string", "minLength": 1, "maxLength": 2048},
        "retryable": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "rightsRecord": {
      "description": "Decision-complete rights metadata for bounded search. Provider inspection exposes the full attribution instruction.",
      "type": "object",
      "required": [
        "basis",
        "identifier",
        "terms_uri",
        "terms_sha256",
        "review_status",
        "redistribution",
        "reviewed_at",
        "expires_at"
      ],
      "properties": {
        "basis": {"enum": ["license", "public-domain", "access-only"]},
        "identifier": {
          "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#spdxExpression"
        },
        "terms_uri": {
          "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
        },
        "terms_sha256": {
          "oneOf": [
            {
              "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#sha256"
            },
            {"type": "null"}
          ]
        },
        "review_status": {"enum": ["reviewed", "unavailable"]},
        "redistribution": {"enum": ["permitted", "not-permitted", "unknown"]},
        "reviewed_at": {
          "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#dateTime"
        },
        "expires_at": {
          "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#dateTime"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"review_status": {"const": "reviewed"}},
            "required": ["review_status"]
          },
          "then": {
            "properties": {
              "terms_sha256": {
                "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#sha256"
              }
            }
          }
        },
        {
          "if": {
            "properties": {"review_status": {"const": "unavailable"}},
            "required": ["review_status"]
          },
          "then": {
            "properties": {
              "basis": {"const": "access-only"},
              "identifier": {"const": "NOASSERTION"},
              "terms_sha256": {"type": "null"},
              "redistribution": {"const": "unknown"}
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract",
    "profile_version",
    "entry_type",
    "status",
    "produced_at",
    "query",
    "providers",
    "hits",
    "deferred_hits",
    "total_returned",
    "more_data_available",
    "continuation",
    "citation_refs",
    "transformation",
    "context",
    "warnings"
  ],
  "properties": {
    "contract": {
      "const": "https://schemas.autonomouslab.io/materials-mcp/plugins/optimade/0.1.0/search-result.schema.json"
    },
    "profile_version": {"const": "0.2.0"},
    "entry_type": {"enum": ["structures", "references"]},
    "status": {"enum": ["complete", "partial"]},
    "produced_at": {
      "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#dateTime"
    },
    "query": {
      "description": "SHA-256 of UTF-8 compact JSON for the complete query plus entry_type, using lexicographically sorted object keys, no insignificant whitespace, and unescaped Unicode.",
      "type": "object",
      "required": ["sha256"],
      "properties": {
        "sha256": {
          "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#sha256"
        }
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "provider_id",
          "database_id",
          "api_base_url",
          "api_version",
          "outcome",
          "pages_returned",
          "records_returned",
          "data_available",
          "more_data_available",
          "response_sha256",
          "retrieved_at",
          "rights",
          "citation_ref",
          "warning_records_observed",
          "warning_records_omitted",
          "warnings"
        ],
        "properties": {
          "provider_id": {"enum": ["mp", "nmd"]},
          "database_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,127}$",
            "maxLength": 128
          },
          "api_base_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^\\s]+$",
            "maxLength": 2048
          },
          "api_version": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^1\\.[0-9]+\\.[0-9]+$",
                "maxLength": 32
              },
              {"type": "null"}
            ]
          },
          "implementation_metadata_sha256": {
            "description": "SHA-256 of the provider-controlled implementation metadata. Recompute over the UTF-8 RFC 8259 compact JSON object {name,version} using lexicographically sorted object keys, no insignificant whitespace, and unescaped Unicode. Inspect the provider for bounded inline name and version values.",
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#sha256"
          },
          "outcome": {"enum": ["success", "empty", "failed"]},
          "pages_returned": {"type": "integer", "minimum": 0, "maximum": 5},
          "records_returned": {"type": "integer", "minimum": 0, "maximum": 100},
          "data_available": {
            "oneOf": [
              {"type": "integer", "minimum": 0},
              {"type": "null"}
            ]
          },
          "more_data_available": {"type": "boolean"},
          "response_sha256": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#sha256"
            }
          },
          "retrieved_at": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#dateTime"
            }
          },
          "page_evidence_commitment": {
            "description": "Commitment over the ordered page-evidence array. Recompute SHA-256 over UTF-8 RFC 8259 JSON for [{\"response_sha256\":HASH,\"retrieved_at\":TIME},...] using lexicographically sorted object keys, no insignificant whitespace, and unescaped Unicode. Its presence requires the two inline evidence arrays to be empty.",
            "type": "object",
            "required": ["count", "sha256"],
            "properties": {
              "count": {"type": "integer", "minimum": 1, "maximum": 5},
              "sha256": {
                "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#sha256"
              }
            },
            "additionalProperties": false
          },
          "rights": {"$ref": "#/$defs/rightsRecord"},
          "citation_ref": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
          },
          "warning_records_observed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 250000
          },
          "warning_records_omitted": {
            "type": "integer",
            "minimum": 0,
            "maximum": 250000
          },
          "warnings": {
            "type": "array",
            "maxItems": 32,
            "items": {"$ref": "#/$defs/providerMessage"}
          },
          "failure": {"$ref": "#/$defs/providerMessage"}
        },
        "allOf": [
          {
            "if": {
              "properties": {"outcome": {"const": "failed"}},
              "required": ["outcome"]
            },
            "then": {"required": ["failure"]}
          },
          {
            "if": {
              "properties": {"outcome": {"enum": ["success", "empty"]}},
              "required": ["outcome"]
            },
            "then": {
              "properties": {
                "api_version": {
                  "type": "string",
                  "pattern": "^1\\.[0-9]+\\.[0-9]+$",
                  "maxLength": 32
                }
              },
              "required": ["implementation_metadata_sha256"]
            }
          },
          {
            "oneOf": [
              {
                "required": ["page_evidence_commitment"],
                "properties": {
                  "response_sha256": {"maxItems": 0},
                  "retrieved_at": {"maxItems": 0}
                }
              },
              {
                "not": {"required": ["page_evidence_commitment"]},
                "if": {
                  "properties": {"pages_returned": {"minimum": 1}},
                  "required": ["pages_returned"]
                },
                "then": {
                  "properties": {
                    "response_sha256": {"minItems": 1},
                    "retrieved_at": {"minItems": 1}
                  }
                }
              }
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    "hits": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "identity",
          "standard_attributes",
          "namespaced_attributes",
          "relationships",
          "included",
          "selected_field_count",
          "returned_selected_field_count",
          "omitted_selected_field_count",
          "unrequested_field_count",
          "page_index",
          "resource_index",
          "warnings"
        ],
        "properties": {
          "identity": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/plugins/optimade/0.1.0/record-identity.extension.schema.json"
          },
          "standard_attributes": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,127}$",
              "maxLength": 128
            },
            "additionalProperties": {"$ref": "#/$defs/boundedValue"}
          },
          "namespaced_attributes": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "type": "string",
              "pattern": "^_[a-z0-9]+_[a-z0-9_]+$",
              "maxLength": 128
            },
            "additionalProperties": {"$ref": "#/$defs/boundedValue"}
          },
          "relationships": {
            "type": "object",
            "maxProperties": 8,
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,127}$",
              "maxLength": 128
            },
            "additionalProperties": {"$ref": "#/$defs/boundedValue"}
          },
          "included": {
            "type": "array",
            "maxItems": 16,
            "items": {"$ref": "#/$defs/boundedValue"}
          },
          "selected_field_count": {"type": "integer", "minimum": 1, "maximum": 32},
          "returned_selected_field_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32
          },
          "omitted_selected_field_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32
          },
          "unrequested_field_count": {"type": "integer", "minimum": 0},
          "page_index": {"type": "integer", "minimum": 0, "maximum": 4},
          "resource_index": {"type": "integer", "minimum": 0, "maximum": 49},
          "warnings": {
            "type": "array",
            "maxItems": 16,
            "items": {"type": "string", "minLength": 1, "maxLength": 1024}
          }
        },
        "additionalProperties": false
      }
    },
    "deferred_hits": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["composite_ref", "reason", "exact_capability_id", "exact_input"],
        "properties": {
          "composite_ref": {
            "type": "string",
            "pattern": "^urn:materials-mcp:optimade:record:[a-f0-9]{64}$",
            "maxLength": 102
          },
          "reason": {"const": "record-exceeds-remaining-inline-context"},
          "exact_capability_id": {
            "enum": [
              "https://schemas.autonomouslab.io/materials-mcp/plugins/optimade/structures/get",
              "https://schemas.autonomouslab.io/materials-mcp/plugins/optimade/references/get"
            ]
          },
          "exact_input": {
            "$ref": "https://schemas.autonomouslab.io/materials-mcp/plugins/optimade/0.1.0/get-input.schema.json"
          }
        },
        "additionalProperties": false
      }
    },
    "total_returned": {"type": "integer", "minimum": 0, "maximum": 100},
    "more_data_available": {"type": "boolean"},
    "continuation": {
      "type": "object",
      "maxProperties": 2,
      "properties": {
        "mp": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,2048}$",
          "maxLength": 2048
        },
        "nmd": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,2048}$",
          "maxLength": 2048
        }
      },
      "additionalProperties": false
    },
    "citation_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/common.schema.json#absoluteReference"
      }
    },
    "transformation": {"const": "selected-field-projection"},
    "context": {
      "type": "object",
      "required": [
        "tokenizer_ref",
        "token_limit",
        "observed_tokens",
        "utf8_byte_limit",
        "observed_utf8_bytes",
        "omitted_hits",
        "deferred_hits"
      ],
      "properties": {
        "tokenizer_ref": {
          "const": "https://github.com/openai/tiktoken/tree/0.14.0#o200k_base"
        },
        "token_limit": {"const": 1500},
        "observed_tokens": {"type": "integer", "minimum": 1, "maximum": 1500},
        "utf8_byte_limit": {"const": 8192},
        "observed_utf8_bytes": {"type": "integer", "minimum": 1, "maximum": 8192},
        "omitted_hits": {"type": "integer", "minimum": 0, "maximum": 100},
        "deferred_hits": {"type": "integer", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    }
  },
  "additionalProperties": false
}
