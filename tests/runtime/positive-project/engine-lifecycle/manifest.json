  "capabilities": [
    {
      "capability_id": "https://schemas.autonomouslab.io/materials-mcp/engine/discover",
      "title": "Discover registered capabilities",
      "description": "Return a deterministic bounded set of compact cards from manifests already validated and registered in the local engine.",
      "effect": {
        "tier": "R0",
        "category": "read-only",
        "description": "Reads immutable in-process registration metadata without network, filesystem, compute, or external effects.",
        "plan_required": false,
        "approval_required": false,
        "strong_confirmation_required": false
      },
      "input_schema": "https://schemas.autonomouslab.io/materials-mcp/engine/0.1.0/discovery-input.schema.json",
      "result_schema": "https://schemas.autonomouslab.io/materials-mcp/engine/0.1.0/discovery-result.schema.json",
      "error_schema": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/structured-error.schema.json",
      "supports_async": false
    },
    {
      "capability_id": "https://schemas.autonomouslab.io/materials-mcp/engine/inspect",
      "title": "Inspect a registered capability",
      "description": "Return immutable identity, effect, and exact schema metadata for one capability already registered in the local engine.",
      "effect": {
        "tier": "R0",
        "category": "read-only",
        "description": "Reads one immutable in-process capability snapshot without network, filesystem, compute, or external effects.",
        "plan_required": false,
        "approval_required": false,
        "strong_confirmation_required": false
      },
      "input_schema": "https://schemas.autonomouslab.io/materials-mcp/engine/0.1.0/inspection-input.schema.json",
      "result_schema": "https://schemas.autonomouslab.io/materials-mcp/engine/0.1.0/inspection-result.schema.json",
      "error_schema": "https://schemas.autonomouslab.io/materials-mcp/0.2.0/structured-error.schema.json",
      "supports_async": false
    }
  ],
